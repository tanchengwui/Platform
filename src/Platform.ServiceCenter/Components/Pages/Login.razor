@page "/login"
@using Platform.ServiceCenter.Services
@inject ApiClient Api
@inject SimpleAuthStateProvider Auth
@inject NavigationManager Nav

<h1>Service Center Login</h1>

<div class="card" style="max-width:420px">
    <div class="card-body">
        <div class="mb-2">
            <label class="form-label">Email</label>
            <input class="form-control" @bind="email" />
        </div>
        <div class="mb-3">
            <label class="form-label">Password</label>
            <input class="form-control" type="password" @bind="password" />
        </div>

        <button class="btn btn-primary" @onclick="DoLogin" disabled="@busy">Login</button>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger mt-3">@error</div>
        }
    </div>
</div>

@code {
    private string email = "admin@local";
    private string password = "Admin123!";
    private bool busy;
    private string? error;

    private async Task DoLogin()
    {
        busy = true;
        error = null;

        try
        {
            var resp = await Api.LoginAsync(email, password);
            Auth.SignInFromJwt(resp.Token, resp.Email); // build claims from JWT for UI
            Nav.NavigateTo("/apps", forceLoad: true);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }
}
