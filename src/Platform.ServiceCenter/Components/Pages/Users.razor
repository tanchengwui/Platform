@page "/users"
@using Platform.ServiceCenter.Services

@inject ApiClient ApiClient

<h1>User Management</h1>

<Can Permission="USER_ADMIN">
    <ChildContent>
        <div class="mb-3" style="max-width:900px;">
            <div class="card p-3">
                <h4>Create user</h4>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">Email</label>
                        <input class="form-control" @bind="NewEmail" placeholder="user@company.com" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Password</label>
                        <input class="form-control" type="password" @bind="NewPassword" placeholder="Min 6 chars" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Roles</label>
                        <div class="d-flex gap-3 flex-wrap">
                            @foreach (var r in Roles)
                            {
                                <label class="form-check-label">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           checked="@SelectedNewRoles.Contains(r.Name)"
                                           @onchange="(e) => ToggleNewRole(r.Name, e)" />
                                    @r.Name
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="CreateUser" disabled="@Busy">Create</button>
                    <button class="btn btn-outline-secondary" @onclick="Reload" disabled="@Busy">Refresh</button>

                    @if (!string.IsNullOrWhiteSpace(Message))
                    {
                        <span class="align-self-center">@Message</span>
                    }
                </div>
            </div>
        </div>

        <div class="card p-3" style="max-width:900px;">
            <h4>Users</h4>

            @if (UserList.Count == 0)
            {
                <p>No users found.</p>
            }
             else
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Email</th>
                                <th>Roles</th>
                                <th>Status</th>
                                <th style="width:320px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in UserList)
                            {
                                <tr>
                                    <td>@u.Email</td>
                                    <td>@string.Join(", ", u.Roles)</td>
                                    <td>@(u.IsActive ? "Active" : "Disabled")</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-2"
                                                @onclick="() => StartEditRoles(u)"
                                                disabled="@Busy">Roles</button>

                                        <button class="btn btn-sm btn-outline-warning me-2"
                                                @onclick="() => StartResetPassword(u)"
                                                disabled="@Busy">Reset PW</button>

                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => ToggleActive(u)"
                                                disabled="@Busy">
                                            @(u.IsActive ? "Disable" : "Enable")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        @if (ShowRolesEditor)
        {
            <div class="card p-3 mt-3" style="max-width:900px;">
                <h4>Edit roles: @EditingUser?.Email</h4>

                <div class="d-flex gap-3 flex-wrap">
                    @foreach (var r in Roles)
                    {
                        <label class="form-check-label">
                            <input class="form-check-input"
                                   type="checkbox"
                                   checked="@EditingRoles.Contains(r.Name)"
                                   @onchange="(e) => ToggleEditRole(r.Name, e)" />
                            @r.Name
                        </label>
                    }
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-primary" @onclick="SaveRoles" disabled="@Busy">Save</button>
                    <button class="btn btn-outline-secondary" @onclick="CancelEdit" disabled="@Busy">Cancel</button>
                </div>
            </div>
        }

        @if (ShowResetPw)
        {
            <div class="card p-3 mt-3" style="max-width:900px;">
                <h4>Reset password: @EditingUser?.Email</h4>

                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">New password</label>
                        <input class="form-control"
                               type="password"
                               @bind="ResetPassword"
                               placeholder="Min 6 chars" />
                    </div>
                </div>

                <div class="mt-3 d-flex gap-2">
                    <button class="btn btn-warning" @onclick="SaveResetPassword" disabled="@Busy">Reset</button>
                    <button class="btn btn-outline-secondary" @onclick="CancelReset" disabled="@Busy">Cancel</button>
                </div>
            </div>
        }
    </ChildContent>

    <Denied>
        <div class="alert alert-danger">
            You do not have permission to manage users.
        </div>
    </Denied>
</Can>

@code {
    private bool Busy;
    private string? Message;

    private List<ApiClient.RoleDto> Roles = new();
    private List<ApiClient.UserAdminDto> UserList = new();

    private string NewEmail = "";
    private string NewPassword = "";
    private HashSet<string> SelectedNewRoles = new(StringComparer.OrdinalIgnoreCase);

    private bool ShowRolesEditor;
    private bool ShowResetPw;
    private ApiClient.UserAdminDto? EditingUser;
    private HashSet<string> EditingRoles = new(StringComparer.OrdinalIgnoreCase);
    private string ResetPassword = "";

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        Busy = true;
        Message = null;

        try
        {
            Roles = await ApiClient.ListRolesAsync();
            UserList = await ApiClient.ListUsersAsync();

            if (SelectedNewRoles.Count == 0 && Roles.Any(r => r.Name == "Viewer"))
                SelectedNewRoles.Add("Viewer");
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void ToggleNewRole(string role, ChangeEventArgs e)
    {
        var on = e?.Value is bool b && b;
        if (on) SelectedNewRoles.Add(role);
         else SelectedNewRoles.Remove(role);
    }

    private void ToggleEditRole(string role, ChangeEventArgs e)
    {
        var on = e?.Value is bool b && b;
        if (on) EditingRoles.Add(role);
        else EditingRoles.Remove(role);
    }

    private async Task CreateUser()
    {
        Busy = true;
        Message = null;

        try
        {
            await ApiClient.CreateUserAsync(NewEmail, NewPassword, SelectedNewRoles.ToList());
            NewEmail = "";
            NewPassword = "";
            Message = "User created.";
            await Reload();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void StartEditRoles(ApiClient.UserAdminDto u)
    {
        EditingUser = u;
        EditingRoles = new HashSet<string>(u.Roles, StringComparer.OrdinalIgnoreCase);
        ShowRolesEditor = true;
        ShowResetPw = false;
        Message = null;
    }

    private void CancelEdit()
    {
        ShowRolesEditor = false;
        EditingUser = null;
        EditingRoles.Clear();
    }

    private async Task SaveRoles()
    {
        if (EditingUser is null) return;

        Busy = true;
        Message = null;

        try
        {
            await ApiClient.SetUserRolesAsync(EditingUser.UserId, EditingRoles.ToList());
            Message = "Roles updated.";
            ShowRolesEditor = false;
            await Reload();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private void StartResetPassword(ApiClient.UserAdminDto u)
    {
        EditingUser = u;
        ResetPassword = "";
        ShowResetPw = true;
        ShowRolesEditor = false;
        Message = null;
    }

    private void CancelReset()
    {
        ShowResetPw = false;
        EditingUser = null;
        ResetPassword = "";
    }

    private async Task SaveResetPassword()
    {
        if (EditingUser is null) return;

        Busy = true;
        Message = null;

        try
        {
            await ApiClient.ResetUserPasswordAsync(EditingUser.UserId, ResetPassword);
            Message = "Password reset.";
            ShowResetPw = false;
            await Reload();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }

    private async Task ToggleActive(ApiClient.UserAdminDto u)
    {
        Busy = true;
        Message = null;

        try
        {
            await ApiClient.SetUserActiveAsync(u.UserId, !u.IsActive);
            Message = "User updated.";
            await Reload();
        }
        catch (Exception ex)
        {
            Message = ex.Message;
        }
        finally
        {
            Busy = false;
        }
    }
}
